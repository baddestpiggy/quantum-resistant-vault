# --- Secrets: never commit these ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# --- Rust ---
/target/
**/*.rs.bk

# --- WASM / web build output ---
/web/pkg/
node_modules/

# --- Vault files: never commit real encrypted files or keys ---
*.vault
*.pqkey
